    board: { mark: showMark(), best: d.show.best, cleared: !!(d.show.ch & 1), gold: !!(d.show.ch & 2), clearRibbons: econ.SHOW_CLEAR, markRibbons: econ.SHOW_MARK },
    name: cafe.loc(th.name),
    color: th.color,
