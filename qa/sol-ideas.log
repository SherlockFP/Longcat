  let pool = [];

  const recycle = (f) => { if (pool.length < POOL && (!best || !best.keep.has(f))) pool.push(f); };

  // copy the board region of the game canvas into a small frame (reusing a pooled canvas of the same size)
  function grab() {
  const d = save.data;
  econ.questsRoll(d, dayNum());
  return {
