// Fast search model: the same rules as rules.js on a compact state, for the generator's decision metrics and hints.
// Every obstacle state is a pure function of WHICH cats have left (a dog counts nearby exits, a frozen cat counts its
// neighbours, a yarn ball goes once any cat passed beside it), and carrier progress follows from how many cats left
// minus how many sit on the bench. So a search state is just (cats gone, bench colour counts), and memo results are
// shared across every query on one board.
import { createState, exitRay, catsNear, edgeNeighbours, DOG_WAKE, DOG_NEAR, THAW_NEED } from './rules.js';

const rootOf = (board, id) => {
  let c = board.cats[id];
  while (c.kittenOf != null) c = board.cats[c.kittenOf];
  return c.id;
};

function liftOrder(st, id, out) {
  out.push(id);
  for (const k of st.kittens[id]) liftOrder(st, k, out);
}

export function compile(board) {
  const { w, h, cats } = board;
  const objs = board.objs || [];
  const st = createState(board);
  const unitOf = new Int16Array(cats.length).fill(-1);
  const units = [];
  for (const c of cats) if (c.kittenOf == null) { unitOf[c.id] = units.length; units.push(c.id); }
  for (const c of cats) if (c.kittenOf != null) unitOf[c.id] = unitOf[rootOf(board, c.id)];
  const N = units.length;
  const ucats = units.map((p) => { const out = []; liftOrder(st, p, out); return out; });
  const len = ucats.map((ids) => ids.reduce((t, id) => t + cats[id].cells.length, 0));
  const rayU = [];
  const rayO = [];
  units.forEach((p) => {
    const su = new Set();
    const so = new Set();
    for (const [x, y] of exitRay(cats[p], w, h)) {
      const o = st.grid[y * w + x];
      if (o >= 0) su.add(unitOf[o]);
      else if (o <= -2) so.add(-2 - o);
    }
    rayU.push(Int16Array.from(su));
    rayO.push(Int16Array.from(so));
  });
  // obstacles: obj k is gone once cnt[k] >= need[k]; frozen unit f thaws once thaw[f] >= THAW_NEED
  const need = new Int16Array(objs.length);
  const hitsO = cats.map(() => []);
  objs.forEach((o, k) => {
    if (o.kind === 'dog') {
      const near = catsNear(board, o.cells, DOG_NEAR);
      need[k] = near.length ? Math.min(DOG_WAKE, near.length) : 9999;
      for (const id of near) hitsO[id].push(k);
    } else {
      need[k] = 1;
      const [yx, yy] = o.cells[0];
      for (const c of cats) {
        const lane = c.cells.concat(exitRay(c, w, h));
        if (lane.some(([x, y]) => Math.abs(x - yx) + Math.abs(y - yy) === 1)) hitsO[c.id].push(k);
      }
    }
  });
  const frozenOf = new Int16Array(N).fill(-1);
  const hitsF = cats.map(() => []);
  let nf = 0;
  units.forEach((p, u) => {
    if (cats[p].mech !== 'frozen') return;
    frozenOf[u] = nf;
    for (const id of edgeNeighbours(board, cats[p])) hitsF[id].push(nf);
    nf++;
  });
  const carriers = board.carriers || [];
  return {
    board, N, units, unitOf, ucats, len, rayU, rayO, need, nObj: objs.length, frozenOf, nFrozen: nf,
    color: Int8Array.from(cats.map((c) => c.color)),
    hitsO: hitsO.map((a) => Int16Array.from(a)),
    hitsF: hitsF.map((a) => Int16Array.from(a)),
    cc: Int8Array.from(carriers.map((c) => c.color)),
    cap: Int8Array.from(carriers.map((c) => c.cap || 3)),
    memo: new Map(),
  };
}

const KEYBUF = new Uint16Array(256);

// A mutable search state over a compiled board, with an undo stack.
export class Sim {
  constructor(C, B) {
    this.C = C;
    this.B = B;
    this.alive = new Uint8Array(C.N).fill(1);
    this.left = C.N;
    this.cnt = new Int16Array(C.nObj);
    this.thaw = new Int16Array(C.nFrozen);
    this.bench = new Int8Array(8);
    this.used = 0;
    this.ci = 0;
    this.fill = 0;
    this.dead = false;
    this.trail = [];
    this.boards = []; // bench cats boarded per carrier arrival during the last apply (chain metrics)
  }

  // From a live rules.js state (mid-game, after scoops or extra seats too).
  static fromState(C, st) {
    const s = new Sim(C, st.benchSize);
    C.units.forEach((p, u) => { if (!st.alive[p]) { s.alive[u] = 0; s.left--; } });
    for (let k = 0; k < C.nObj; k++) s.cnt[k] = !st.objAlive[k] ? C.need[k] : st.objs[k].kind === 'dog' ? st.dogCount[k] : 0;
    C.units.forEach((p, u) => { const f = C.frozenOf[u]; if (f >= 0) s.thaw[f] = st.frozen[p] ? st.thaw[p] : THAW_NEED; });
    for (const id of st.bench) if (id >= 0) { s.bench[C.color[id]]++; s.used++; }
    s.ci = st.carriers.length ? st.carriers[0].uid : C.cc.length;
    s.fill = st.carriers.length ? st.carriers[0].fill : 0;
    s.dead = !!st.failed;
    return s;
  }

  frozen(u) {
    const f = this.C.frozenOf[u];
    return f >= 0 && this.thaw[f] < THAW_NEED;
  }

  objAlive(k) {
    return this.cnt[k] < this.C.need[k];
  }

  canExit(u) {
    const C = this.C;
    if (!this.alive[u] || this.frozen(u)) return false;
  const meta = { n, tutorial: true, kind: 'normal', benchSize: 5 };
  let cats;
  let carriers;
  if (n === 1) {
    cats = mk([
      { cells: [[1, 4], [1, 3], [1, 2]], breed: 'tabby' }, // orange
      { cells: [[3, 5], [3, 4], [3, 3], [3, 2]], breed: 'tabby' }, // orange
      { cells: [[2, 5], [2, 4], [2, 3]], breed: 'tabby' }, // orange
    ]);
    carriers = [{ color: 0, cap: 3 }]; // three quick taps fill it: the first door-snap and drive-off
    meta.order = [0, 1, 2];
  } else if (n === 2) {
    // A forced zigzag that teaches the bench by hand: blue, orange, blue, orange, blue. Each cat frees only the next.
    // The two blues park; the second orange sends the orange carrier off, the blue one rolls in and BOTH parked cats
    // hop in by themselves (the first chain), then the last blue fills it.
    cats = mk([
      { cells: [[1, 1], [2, 1], [3, 1]], breed: 'tuxedo' }, // 0 blue, the only free cat: parks
      { cells: [[2, 3], [2, 2]], breed: 'tabby' }, // 1 orange, held by 0
      { cells: [[4, 3], [3, 3]], breed: 'tuxedo' }, // 2 blue, held by 1: parks
      { cells: [[3, 5], [3, 4]], breed: 'tabby' }, // 3 orange, held by 2: fills the orange carrier, the chain fires
      { cells: [[0, 5], [1, 5], [2, 5]], breed: 'tuxedo' }, // 4 blue, held by 3: fills the blue carrier
    ]);
    carriers = [{ color: 0, cap: 2 }, { color: 1, cap: 3 }];
    meta.order = [0, 1, 2, 3, 4];
  } else if (n === 4) {
    // A packed 5x6 board (no empty rows) built around one real choice: no pink cat is free, so something must park.
    // Free at the start: green 7 (green is the NEXT carrier: it hops in soon) and blue 2 (blue comes LAST: it squats
    // on a seat all level). Exhaustive search: random play wins 72% overall, 85% after parking green first, 59% after
    // blue first; the best line peaks at 4 of 5 seats. The hint card states the rule, never the tap.
    cats = mk([
      { cells: [[3, 5], [2, 5]], breed: 'calico' }, // 0 pink
      { cells: [[2, 2], [2, 3]], breed: 'tabby' }, // 1 orange
      { cells: [[0, 2], [0, 1], [0, 0]], breed: 'tuxedo' }, // 2 blue, free (comes last)
      { cells: [[1, 5], [0, 5], [0, 4]], breed: 'tabby' }, // 3 orange
      { cells: [[1, 1], [2, 1]], breed: 'tuxedo' }, // 4 blue
      { cells: [[1, 3], [1, 4], [2, 4]], breed: 'gray' }, // 5 green
      { cells: [[3, 0], [4, 0], [4, 1]], breed: 'calico' }, // 6 pink
      { cells: [[4, 4], [4, 5]], breed: 'gray' }, // 7 green, free (comes next)
      { cells: [[2, 0], [1, 0]], breed: 'gray' }, // 8 green
      { cells: [[4, 2], [4, 3]], breed: 'tuxedo' }, // 9 blue
      { cells: [[3, 3], [3, 4]], breed: 'calico' }, // 10 pink
      { cells: [[3, 1], [3, 2]], breed: 'tabby' }, // 11 orange
    ]);
    carriers = [{ color: 2, cap: 3 }, { color: 3, cap: 3 }, { color: 0, cap: 3 }, { color: 1, cap: 3 }]; // pink, green, orange, blue
    meta.order = [2, 3, 0, 7, 9, 6, 10, 5, 1, 8, 11, 4]; // a winning line that peaks at 4 of 5 seats
    meta.detours = 4;
    meta.colors = 4;
    return makeBoard(5, 6, cats, meta, carriers);
  } else {
    // Mother + kitten AND a first real choice on a cramped 4-seat bench. Free at the start: the orange mother (her
    // kitten trails, 2 of 3 orange seats in one tap) and a big pink mother + kitten whose carrier comes LAST. Orange
    // first sets up the chain (two blues park, the last orange fills, both blues hop in). Pink first is survivable but
    // the pair squats on 2 seats for the whole level and the two blues fill the bench to 4 of 4: the lesson card says
    // so the moment the pair parks, before any trap is fatal (the first irreversible trap waits for L4).
    cats = mk([
      { cells: [[2, 0], [3, 0], [4, 0]], breed: 'tabby' }, // 0 orange mother, free
      { cells: [[0, 0], [1, 0]], breed: 'tabby', kittenOf: 0 }, // 1 her kitten
      { cells: [[1, 2], [1, 1]], breed: 'tuxedo' }, // 2 blue, held by the kitten: parks
      { cells: [[3, 1], [2, 1]], breed: 'tuxedo' }, // 3 blue, held by 2: parks
      { cells: [[3, 3], [3, 2]], breed: 'tabby' }, // 4 orange, held by 3: fills orange, both blues hop in, blue departs too
      { cells: [[4, 3], [4, 4], [4, 5]], breed: 'calico' }, // 5 pink mother, free from the start (the tempting wrong tap)
      { cells: [[4, 1], [4, 2]], breed: 'calico', kittenOf: 5 }, // 6 her kitten
    ]);
    carriers = [{ color: 0, cap: 3 }, { color: 1, cap: 2 }, { color: 2, cap: 2 }];
    meta.benchSize = 4;
    meta.order = [0, 2, 3, 4, 5];
  }
  return makeBoard(5, 6, cats, meta, carriers);
}

// ---- one generation attempt ----
function runAttempt(P, rng) {
  const W = P.w;
  const H = P.h;
  const N = W * H;
  const occ = new Int16Array(N).fill(-1);
  const stamp = new Int32Array(N);
  let cur = 0;
  const rayOwn = Array.from({ length: N }, () => []);
  const units = [];
  const down = [];
  const bm = [];
  const pm = [];
  let evalStamp = 0;
  let filled = 0;
