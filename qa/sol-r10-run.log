// Friend challenge links: ?c=<base64url JSON> names one exact board and one goal. No accounts, no backend: the link is
// all there is, so decode() trusts nothing in it (shape, numbers, name) and clamps every field.
//   { v: 1, n: board level number, b: bench seats, k: 'l' level | 'd' daily | 's' Cat Show | 'r' Caf� Rush,
//     m: 'chain' | 'seats' | 'time', g: target (chain size, seats used, or tenths of a second), nm?: sender name,
//     x?: 1 = the chain goal is already the board's best (the recipient is asked to match it, not beat it),
//     i?: share id (a few base36 chars): ties the sender's handoff to the recipient's open, first move, clear and reshare }
export const MODES = ['chain', 'seats', 'time'];
const KINDS = ['l', 'd', 's', 'r'];
const MAX_LEN = 400;

const int = (v, lo, hi) => (Number.isFinite(+v) ? Math.max(lo, Math.min(hi, Math.round(+v))) : null);

// letters, digits, spaces and a few name marks only; at most 12 characters
export function cleanName(s) {
  if (typeof s !== 'string') return '';
  return s.normalize('NFC').replace(/[^\p{L}\p{N} '.-]/gu, '').replace(/\s+/g, ' ').trim().slice(0, 12).trim();
}

function b64url(str) {
  const bytes = new TextEncoder().encode(str);
  let bin = '';
  for (const x of bytes) bin += String.fromCharCode(x);
  return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
}
function unb64url(s) {
  const bin = atob(s.replace(/-/g, '+').replace(/_/g, '/'));
  return new TextDecoder().decode(Uint8Array.from(bin, (c) => c.charCodeAt(0)));
}

export function encode(d) {
  const o = { v: 1, n: d.n, b: d.b, k: d.k, m: d.m, g: d.g };
  const nm = cleanName(d.nm);
  if (nm) o.nm = nm;
  if (d.x) o.x = 1;
  if (d.i && /^[a-z0-9]{1,8}$/.test(d.i)) o.i = d.i;
  return b64url(JSON.stringify(o));
}

// baseBench(n): the board's own seat count; a link may add at most two seats (the sender's perk seats), never remove any
export function decode(code, baseBench) {
  if (typeof code !== 'string' || !code || code.length > MAX_LEN || !/^[A-Za-z0-9_-]+$/.test(code)) return null;
  let o;
  try { o = JSON.parse(unb64url(code)); } catch { return null; }
  if (!o || typeof o !== 'object' || Array.isArray(o) || o.v !== 1) return null;
  const n = int(o.n, 1, 999);
  const m = MODES.includes(o.m) ? o.m : null;
  if (n == null || !m) return null;
  const k = KINDS.includes(o.k) ? o.k : 'l';
  const base = baseBench(n);
  const b = int(o.b, base, base + 2) ?? base;
  let g;
  if (m === 'chain') g = int(o.g, 2, 8);
  else if (m === 'seats') g = int(o.g, 0, b);
  else g = int(o.g, 30, 9000); // 3 s .. 15 min, in tenths
  if (g == null) return null;
  const out = { n, b, k, m, g, nm: cleanName(o.nm) };
  if (m === 'chain' && o.x === 1) out.x = 1;
  if (typeof o.i === 'string' && /^[a-z0-9]{1,8}$/.test(o.i)) out.i = o.i;
  return out;
}

// a fresh share id for the funnel (not a user id: random, per share)
export const shareId = () => Math.floor(Math.random() * 36 ** 6).toString(36).padStart(6, '0');

// how the run went against the goal: 'beat' | 'tie' | 'miss' (v = the player's own chain / seats / tenths)
export function judge(m, g, v) {
  if (m === 'chain') return v > g ? 'beat' : v === g ? 'tie' : 'miss';
  if (m === 'seats') return v < g ? 'beat' : v === g ? 'tie' : 'miss';
  return v < g ? 'beat' : v === g ? 'tie' : 'miss';
}

// Turkish genitive of a name with an apostrophe (Ana'nin, Ali'nin, Murat'in, G�l'�n): last vowel harmony, -n- after a vowel
export function trGenitive(name) {
  const vow = 'aiouei��AIOUEI��';
  const low = name.toLocaleLowerCase('tr');
  let last = '';
  for (const c of low) if (vow.toLocaleLowerCase('tr').includes(c)) last = c;
  const suf = { a: 'in', i: 'in', o: 'un', u: 'un', e: 'in', i: 'in', �: '�n', �: '�n' }[last] || 'in';
  const endsVowel = vow.toLocaleLowerCase('tr').includes(low.at(-1) || '');
  return `${name}'${endsVowel ? 'n' : ''}${suf}`;
}
// Versioned localStorage save. Safe when storage is blocked.
import { TASK_POOL } from '../game/econ.js';

const KEY = 'lco_save';
const VERSION = 8;

const defaults = () => ({
  v: VERSION,
  level: 1,
  coins: 50,
  bestStars: {},
  settings: { sound: true, music: true, haptics: true, lang: guessLang(), notify: false }, // music: older saves get it on through the defaults merge
  daily: { last: '', streak: 0, doneDay: '', shieldW: -1 }, // shieldW: the week whose one free missed day is spent
  ads: { wins: 0, lastInterstitial: 0, removeAds: false },
  counters: {},
  boosters: { hint: 3, scoop: 2, undo: 3 },
  cafe: { stars: 0, built: {}, hintDay: '', hintN: 0, scoopLevel: 0, love: {}, party: 0, hearts: {}, wear: {}, petDay: {}, street: 0, reno: {}, style: {} }, // street: Cat Street pieces built (src/game/street.js); reno: area id -> owned theme-set bits; style: area id -> shown set // hintN: free perk hints used on hintDay; love: resident id -> affection level 0..3 (treats)
  lives: { n: 5, t: 0 }, // t = when the next life regen started (0 while full)
  purr: { n: 0, pend: 0, lost: 0, seatLv: 0 }, // Purr Streak count + the bonus waiting for the next level (0/1/2) + the level last lost (so a restart cannot fake a first try) + the level whose bonus bench seat is still owed
  quests: { day: 0, list: [], chest: 0 }, // 3 daily tasks: { id, p: progress, c: claimed }
  login: { last: 0, idx: 0 }, // 7-day calendar: last claimed day number, claims in this cycle
  show: { week: 0, decor: {}, marks: {}, goals: {}, from: 0 }, // weekly Cat Show: decor = rosettes won (theme id), marks = board key ('<week>a|b') -> medal bits (1 bronze, 2 gold), goals = computed board goals, from = first Show week (archive start)
  shop: { starterShown: false, offerDay: -1 }, // offerDay: the day the hub's Shop 'Offer' badge was last seen (once a day)
  iap: { owned: {}, tx: [] }, // non-consumables owned + recent transaction ids (no double grants)
  clock: { max: 0 }, // highest time ever seen: the rollback guard
  // v8 retention (src/game/live.js): tip jar fill start, resident requests, Caf� Rush, season stamps/claims, visiting cats
  jar: { t: 0, total: 0 },
  req: { list: [], next: 0, n: 0, done: 0, fresh: '' }, // fresh: the newcomer whose first request leads the hub (kept across reloads)
  rush: { week: 0, best: 0, cats: 0, pend: null, cups: {} },
  season: { daily: {}, claim: {}, visDay: 0 },
  vis: {},
  meta: { firstOpen: 0, sessions: 0, funnel: {}, ret: {}, shareNudge: 0, dares: 0 }, // shareNudge: the first "show a friend" prompt was shown; dares: friend challenges played
});

function guessLang() {
  try {
    return (navigator.language || 'en').toLowerCase().startsWith('tr') ? 'tr' : 'en';
  } catch {
    return 'en';
  }
}

function merge(base, over) {
  for (const k of Object.keys(base)) {
    if (over && over[k] !== undefined) {
      if (isObj(base[k])) merge(base[k], isObj(over[k]) ? over[k] : {});
      else base[k] = over[k];
    }
  }
  return base;
}

// v1 (MVP) saves keep level, coins, stars and settings; v2 adds booster counts (they stay at the defaults).
// v3 adds the Cat Caf�: an MVP player gets a head start of caf� stars for the levels already cleared (capped), nothing pre-built.
function migrate(raw) {
