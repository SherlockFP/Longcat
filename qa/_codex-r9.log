  const plan = planClip(game.log, true);
  if (!plan) return clip.clear();
  const result = plan.kind === 'chain' ? t('chainX', { n: plan.n }) : S.winPeak === 0 ? t('clipNoBench') : t('clipClear');
  clip.set({
    board: game.board,
    log: game.log.slice(),
    plan,
    text: { combo: [t('purrfect'), t('combo2'), t('combo3')], chainX: (n) => t('chainX', { n }), lastSeat: t('lastSeat'), title: t('title'), board: boardName(), result, can: t('clipCan'), link: t('clipLink'), bench: (u, n) => t('clipBench', { u, n }), chain: t('clipChain') },
  });
