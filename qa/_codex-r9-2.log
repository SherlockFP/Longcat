// share a file (with the text and the challenge link) when the platform can, else download it and copy the text;
// returns 'shared' | 'saved' | 'cancel'
export async function shareFile({ blob, ext }, name, text, url) {
  const file = typeof File !== 'undefined' ? new File([blob], `${name}.${ext}`, { type: blob.type }) : null;
  if (file && navigator.canShare && navigator.canShare({ files: [file] }) && navigator.share) {
    try {
      await navigator.share({ files: [file], text: url ? `${text} ${url}` : text });
      return 'shared';
    } catch (e) {
      if (e && e.name === 'AbortError') return 'cancel';
    }
  }
  const href = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = href;
  a.download = `${name}.${ext}`;
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(() => URL.revokeObjectURL(href), 4000);
  try { if (navigator.clipboard) await navigator.clipboard.writeText(url ? `${text} ${url}` : text); } catch { /* no permission */ }
  return 'saved';
}
