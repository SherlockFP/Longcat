      }
      const bad = d.kind === 'fail';
      ctx.save();
      ctx.globalAlpha = 0.5 + 0.5 * u;
      ctx.lineWidth = 4;
      ctx.strokeStyle = bad ? '#e53935' : '#fff6e5';
